{
  "entities": {
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Global business settings and contact info",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "phoneInternational": { "type": "string", "maxLength": 50 },
        "whatsappUrl": { "type": "string", "maxLength": 200 },
        "mapUrl": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 1000 },
        "email": { "type": "string", "maxLength": 100 }
      },
      "required": ["name", "phone", "address"]
    },
    "PageContent": {
      "title": "Page Content",
      "description": "Draft or published page content",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 500 },
        "heroImage": { "type": "string", "maxLength": 500 },
        "heroSlides": { "type": "string", "maxLength": 10000 },
        "editorialImage": { "type": "string", "maxLength": 500 },
        "editorialTitle": { "type": "string", "maxLength": 200 },
        "editorialSubtitle": { "type": "string", "maxLength": 200 },
        "editorialText": { "type": "string", "maxLength": 2000 },
        "sections": { "type": "string", "maxLength": 5000 }
      }
    },
    "Product": {
      "title": "Product",
      "description": "Furniture product item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["living-room", "bedroom", "custom", "other"] },
        "categoryLabel": { "type": "string", "maxLength": 50 },
        "image": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 2000 },
        "materials": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "name", "category", "image"]
    },
    "GalleryItem": {
      "title": "Gallery Item",
      "description": "Gallery photo item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "image": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "title", "image"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Customer contact inquiry",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "preferredContact": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "read", "archived"] }
      },
      "required": ["fullName", "phone", "message"]
    }
  },
  "firestore": {
    "/settings/global": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global business settings"
    },
    "/pagesDrafts/{pageId}": {
      "schema": { "$ref": "#/entities/PageContent" },
      "description": "Editable page drafts"
    },
    "/pagesPublished/{pageId}": {
      "schema": { "$ref": "#/entities/PageContent" },
      "description": "Live published page content"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Furniture catalog items"
    },
    "/galleryItems/{galleryId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Gallery photos"
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Customer contact messages"
    }
  }
}
